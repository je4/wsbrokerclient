<div class="space-y-1">
{{ range .Channels }}
    <button
        hx-post="/chat/channel"
        hx-vals='{"channel": "{{ . }}"}'
        hx-target="#messages-container"
        hx-swap="innerHTML"
        class="w-full flex items-center justify-between px-3 py-2 rounded-lg text-sm font-medium transition-colors text-left {{ if eq . $.ActiveChannel }}bg-teal-500/10 text-teal-700 dark:text-teal-300 font-semibold border border-teal-500/20{{ else }}text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800/60 hover:text-slate-900 dark:hover:text-slate-200{{ end }}"
        onclick="setActiveChannelTitle('{{ . }}')">
        <span class="flex items-center gap-2 truncate">
            <span class="text-xs font-mono text-slate-400 dark:text-slate-500">#</span>
            <span class="truncate">{{ . }}</span>
        </span>
        {{ if eq . $.ActiveChannel }}
        <span class="w-2 h-2 rounded-full bg-teal-500"></span>
        {{ end }}
    </button>
{{ else }}
    <p class="text-xs text-slate-400 dark:text-slate-500 px-3 py-2">No channels configured</p>
{{ end }}
</div>
