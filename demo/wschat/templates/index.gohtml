<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>WSChat - WSBroker Channel Chat</title>
    <script>
        function syncTheme() {
            if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
                document.documentElement.classList.add('dark');
            } else {
                document.documentElement.classList.remove('dark');
            }
        }
        syncTheme();
        if (window.matchMedia) {
            window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', syncTheme);
        }
    </script>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/htmx.org@2.0.11"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#f0fdfa',
                            500: '#14b8a6',
                            600: '#0d9488',
                            700: '#0f766e',
                        }
                    }
                }
            }
        }

        function scrollMessagesToBottom() {
            const container = document.getElementById('messages-container');
            if (container) {
                container.scrollTop = container.scrollHeight;
            }
        }

        function setActiveChannelTitle(name) {
            const el = document.getElementById('active-channel-title');
            if (el) el.innerText = '#' + name;
            const inputChan = document.getElementById('input-channel');
            if (inputChan) inputChan.value = name;
            htmx.trigger(document.body, 'refresh-channels');
        }

        document.addEventListener('htmx:afterSwap', function(evt) {
            if (evt.detail.target.id === 'messages-container') {
                scrollMessagesToBottom();
            }
        });
    </script>
</head>
<body class="h-full flex flex-col font-sans antialiased bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-slate-100">
    <!-- Header -->
    <header class="border-b border-slate-200 dark:border-slate-800 bg-white/80 dark:bg-slate-900/80 backdrop-blur sticky top-0 z-40">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3.5 flex flex-wrap items-center justify-between gap-4">
            <div class="flex items-center space-x-3">
                <div class="p-2 bg-teal-500/10 border border-teal-500/20 rounded-lg text-teal-600 dark:text-teal-400">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
                    </svg>
                </div>
                <div>
                    <h1 class="text-lg font-bold tracking-tight text-slate-900 dark:text-white flex items-center gap-2">
                        WSChat
                        <span class="text-xs px-2 py-0.5 rounded-full bg-teal-500/10 text-teal-700 dark:text-teal-400 border border-teal-500/30">Demo</span>
                    </h1>
                    <p class="text-xs text-slate-500 dark:text-slate-400">WSBroker Channel Communication Demo</p>
                </div>
            </div>

            <div class="flex items-center gap-3">
                <!-- Status Badge -->
                <div id="status-container"
                     hx-get="/chat/status"
                     hx-trigger="load, every 2s"
                     class="px-3 py-1.5 rounded-lg bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700/60">
                    {{ template "statusPartial" . }}
                </div>

                <!-- Client Badge -->
                <div class="px-3 py-1.5 text-xs font-medium text-slate-700 dark:text-slate-300 bg-slate-100 dark:bg-slate-800 rounded-lg border border-slate-200 dark:border-slate-700/60 flex items-center gap-1.5">
                    <svg class="w-3.5 h-3.5 text-teal-600 dark:text-teal-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                    </svg>
                    <span>Client: <span class="font-semibold text-teal-700 dark:text-teal-400">{{ .ClientName }}</span></span>
                </div>
            </div>
        </div>
    </header>

    <!-- Main Container -->
    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 flex flex-col min-h-0">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-6 flex-1 min-h-[500px]">
            <!-- Channels Sidebar (1 col) -->
            <div class="md:col-span-1 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl overflow-hidden shadow-sm flex flex-col">
                <div class="px-4 py-3 border-b border-slate-200 dark:border-slate-800 flex items-center justify-between">
                    <h2 class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">Channels</h2>
                    <span class="text-[10px] px-1.5 py-0.5 rounded bg-slate-100 dark:bg-slate-800 text-slate-500 font-mono">mTLS</span>
                </div>

                <!-- Channels List -->
                <div id="channels-container"
                     hx-get="/chat/channels"
                     hx-trigger="load, refresh-channels from:body"
                     class="p-3 flex-1 overflow-y-auto space-y-1">
                    {{ template "channelsPartial" . }}
                </div>

                <!-- Join / Attach Channel Form -->
                <div class="p-3 border-t border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-900/50">
                    <form hx-post="/chat/join"
                          hx-target="#messages-container"
                          hx-swap="innerHTML"
                          hx-on::after-request="this.reset();"
                          class="flex items-center gap-1.5">
                        <input type="text"
                               name="channel"
                               placeholder="Join channel..."
                               required
                               class="w-full px-2.5 py-1.5 text-xs rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-slate-100 focus:outline-none focus:ring-1 focus:ring-teal-500 placeholder-slate-400" />
                        <button type="submit"
                                title="Join Channel"
                                class="px-2.5 py-1.5 bg-teal-600 hover:bg-teal-700 text-white rounded-lg text-xs font-medium transition shadow-sm flex items-center justify-center">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                            </svg>
                        </button>
                    </form>
                </div>
            </div>

            <!-- Chat Window (3 cols) -->
            <div class="md:col-span-3 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl overflow-hidden shadow-sm flex flex-col">
                <!-- Channel Header -->
                <div class="px-6 py-3.5 border-b border-slate-200 dark:border-slate-800 flex items-center justify-between bg-slate-50/50 dark:bg-slate-900/50">
                    <div class="flex items-center gap-2">
                        <span class="text-teal-600 dark:text-teal-400 font-bold text-lg" id="active-channel-title">#{{ .ActiveChannel }}</span>
                        <span class="text-xs text-slate-400 dark:text-slate-500">Live channel stream</span>
                    </div>
                    <button
                        onclick="htmx.trigger('#messages-container', 'refresh');"
                        class="px-2.5 py-1 text-xs text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-md transition flex items-center gap-1">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                        </svg>
                        Refresh
                    </button>
                </div>

                <!-- Messages Feed -->
                <div id="messages-container"
                     hx-get="/chat/messages"
                     hx-trigger="load, every 1s, refresh, refresh-messages from:body"
                     hx-swap="innerHTML"
                     class="flex-1 p-6 overflow-y-auto space-y-3 bg-slate-50/30 dark:bg-slate-950/20">
                    {{ template "messagesPartial" . }}
                </div>

                <!-- Message Input Bar -->
                <div class="p-4 border-t border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900">
                    <form id="chat-form"
                          hx-post="/chat/send"
                          hx-target="#messages-container"
                          hx-swap="innerHTML"
                          hx-on::after-request="this.reset(); scrollMessagesToBottom();"
                          class="flex items-center gap-3">
                        <input type="hidden" name="channel" id="input-channel" value="{{ .ActiveChannel }}" />
                        <div class="relative flex-1">
                            <input type="text"
                                   id="message-input"
                                   name="message"
                                   placeholder="Type a message to broadcast..."
                                   autocomplete="off"
                                   required
                                   class="w-full pl-4 pr-10 py-2.5 text-sm rounded-xl border border-slate-300 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/80 text-slate-900 dark:text-slate-100 focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-teal-500 placeholder-slate-400 dark:placeholder-slate-500 transition" />
                        </div>
                        <button type="submit"
                                class="px-5 py-2.5 bg-teal-600 hover:bg-teal-700 active:bg-teal-800 text-white rounded-xl text-sm font-semibold transition shadow-sm hover:shadow flex items-center gap-1.5 shrink-0">
                            <span>Send</span>
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                            </svg>
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </main>

    <!-- Footer -->
    <footer class="border-t border-slate-200 dark:border-slate-800 py-3 text-center text-xs text-slate-400 dark:text-slate-600">
        <span>WSBroker Chat Client &bull; Built with Go, Tailwind CSS &amp; HTMX</span>
    </footer>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            scrollMessagesToBottom();
        });
    </script>
</body>
</html>
